# Cognee provider
# Blablador is FZ Juelich's LLM service
LLM_PROVIDER="custom"
LLM_MODEL="openai/alias-fast"  # requires openai prefix
LLM_ENDPOINT="https://api.blablador.fz-juelich.de/v1"
LLM_API_KEY="your-blablador-api-key"

EMBEDDING_PROVIDER="custom"
EMBEDDING_MODEL="openai/alias-embeddings"
EMBEDDING_ENDPOINT="https://api.blablador.fz-juelich.de/v1"
EMBEDDING_API_KEY="your-blablador-api-key"
EMBEDDING_DIMENSIONS=4096

# Client side rate limits
# https://sdlaml.pages.jsc.fz-juelich.de/ai/guides/blablador_api_access/
COGNEE_SKIP_CONNECTION_TEST=true
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=10
LLM_RATE_LIMIT_INTERVAL=60
EMBEDDING_RATE_LIMIT_ENABLED=true
EMBEDDING_RATE_LIMIT_REQUESTS=10
EMBEDDING_RATE_LIMIT_INTERVAL=60

# Cognee storage, all under /home/<user>/.cognee
DATA_ROOT_DIRECTORY="/home/<user>/.cognee/data"
SYSTEM_ROOT_DIRECTORY="/home/<user>/.cognee/system"
CACHE_ROOT_DIRECTORY="/home/<user>/.cognee/cache"

# Memory improvement
CACHING=true
COGNEE_AUTO_IMPROVE_EVERY=10

# Docker Compose deployment
COMPOSE_PROJECT_NAME=gamma-aistronomer  # project prefix, change for an isolated Cognee stack
COGNEE_EXPORT_PATH=../../data/cache/exported  # cogx archives cognee-import loads, absolute or relative to deploy/cognee/
COGNEE_BACKEND_PORT=8000  # change any port already in use
COGNEE_MCP_PORT=8001
COGNEE_FRONTEND_PORT=3000

# CTAO dataset
CTAO_DATA_PATH=../data/cache/gammapy/ctao-data/data-transfer  # DL3 DataStore dir with the FITS files, point it at your dataset

# Backend
COGNEE_SERVICE_URL="http://localhost:8000"  # match COGNEE_BACKEND_PORT, sets the deployment NEXT_PUBLIC_LOCAL_API_URL
COGNEE_API_KEY="your-cognee-api-key"

# MCP
COGNEE_JWT="your-cognee-jwt"
JWT_LIFETIME_SECONDS=31536000  # 1 year

# Cognee cloud (optional)
COGNEE_CLOUD_SERVICE_URL="https://your-tenant.aws.cognee.ai"
COGNEE_CLOUD_USER_ID="your-cognee-cloud-user-id"
COGNEE_CLOUD_API_KEY="your-cognee-cloud-api-key"

# LiteLLM
DISABLE_AIOHTTP_TRANSPORT=false
LITELLM_DROP_PARAMS=true  # embedding endpoint rejects extra params
