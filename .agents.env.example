# Cognee interface via MCP
COGNEE_MCP_URL="https://your-cognee-mcp-host/mcp"  # or local http://host.docker.internal:8001/mcp

# Agent LLM provider, filled into the Pi and OpenCode configs
# Change Blablador to any custom provider
AGENT_LLM_ENDPOINT="https://api.blablador.fz-juelich.de/v1"
AGENT_LLM_API_KEY="your-blablador-api-key"
AGENT_LLM_MODEL_ID="alias-fast"  # no openai prefix here
AGENT_LLM_MODEL_NAME="Blablador Fast (GPT-OSS-120b)"  # display name
