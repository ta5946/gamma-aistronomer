FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       bash ca-certificates gettext-base git ripgrep python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*
RUN pip install --break-system-packages --no-cache-dir gammapy==2.1 regions==0.11
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.84.2 \
  && pi install npm:pi-mcp-adapter@2.26.0 \
  && pi install npm:@narumitw/pi-plan-mode@0.50.1

WORKDIR /workspace
ENTRYPOINT ["pi"]
